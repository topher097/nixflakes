{
  pkgs,
  lib,
  username,
  inputs,
  ...
}:
let
  opencodeConfig = lib.importJSON ./opencode.json;
  opencodeNotifierConfig = lib.importJSON ./opencode-notifier.json;
  # oh-my-opencode-slim agent preset (generated by `bunx oh-my-opencode-slim
  # install --preset=opencode-go`, then vendored so every machine matches).
  opencodeSlimConfig = lib.importJSON ./oh-my-opencode-slim.json;
in
{
  environment.systemPackages = with pkgs; [
    python3
    unstable.opencode
    bun
    gh
    libnotify
    nodejs
  ];

  home-manager.users.${username} = {
    imports = [
      inputs.agent-skills.homeManagerModules.default
    ];

    programs.agent-skills = {
      enable = true;

      sources.caveman = {
        input = "caveman";
        subdir = "skills";
        filter.maxDepth = 1;
      };

      sources.pstack = {
        input = "pstack";
        subdir = "skills";
      };

      skills.enable = [
        "caveman"
        "caveman-commit"
        "caveman-help"
        "caveman-review"
        "caveman-compress"
      ];

      # All 53 pstack skills (29 workflow + 24 principle-*).
      skills.enableAll = [ "pstack" ];

      targets.opencode = {
        dest = "/home/${username}/.config/opencode/skills";
        structure = "symlink-tree";
        enable = true;
      };
    };

    home.file = {
      ".config/opencode/opencode.json".text = builtins.toJSON opencodeConfig;
      ".config/opencode/opencode-notifier.json".text = builtins.toJSON opencodeNotifierConfig;
      ".config/opencode/oh-my-opencode-slim.json".text = builtins.toJSON opencodeSlimConfig;
      ".config/opencode/AGENTS.md".source = ./AGENTS.md;
    };

    # opencode.json points "skills" at ~/.config/opencode/skills-local; create it
    # here so the path resolves on every machine (skills themselves go in via
    # home.file, never by hand).
    home.activation.createOpencodeSkillsLocal =
      inputs.home-manager.lib.hm.dag.entryAfter [ "writeBoundary" ]
        ''
          mkdir -p "$HOME/.config/opencode/skills-local"
        '';

    # opencode caches npm plugin resolutions (@latest) under ~/.cache/opencode/npm
    # and keeps serving stale copies across rebuilds. Purge the whole cache so
    # every rebuild re-resolves all plugins to the newest version from npm on
    # the next plugin load.
    home.activation.refreshOpencodePlugins =
      inputs.home-manager.lib.hm.dag.entryAfter [ "writeBoundary" ]
        ''
          rm -rf "$HOME/.cache/opencode/npm"
        '';
  };
}
