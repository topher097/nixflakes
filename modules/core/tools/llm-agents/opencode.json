{
  '$schema': 'https://opencode.ai/config.json',
  'plugin': [
    '@mohak34/opencode-notifier@0.2.2'
  ],
  'agent': {
    'build': {
      'model': 'opencode/glm-5'
    },
    'plan': {
      'model': 'opencode/minimax-m2.7'
    },
    'general': {
      'description': 'General-purpose agent for researching complex questions and executing multi-step tasks',
      'mode': 'subagent',
      'prompt': 'You are a general-purpose agent for researching complex questions and executing multi-step tasks.'
    },
    'explore': {
      'description': 'Fast read-only agent for exploring codebases',
      'mode': 'subagent',
      'prompt': 'You are a fast, read-only agent for exploring codebases. Cannot modify files.'
    }
  },
  'permission': {
    'skill': {
      '*': 'allow'
    }
  }
}